# ============================================================
# SMARTLANKA TRADE — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================

# ------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------
PORT=5000
NODE_ENV=development
BASE_URL=http://localhost:5000
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# ------------------------------------------------------------
# 2. Oracle Database Configuration
# ------------------------------------------------------------
# Option A: Local Oracle Database (XE / FREE / 21c / 19c)
# connectString examples: localhost:1521/XEPDB1, localhost:1521/FREE, localhost:1521/ORCL
DB_USER=your_oracle_username
DB_PASSWORD=your_oracle_password
DB_CONNECT=localhost:1521/XEPDB1

# Option B: Oracle Autonomous Cloud Database (with Cloud Wallet)
# If using Oracle Cloud ATP/ADW, set DB_CONNECT to service alias (e.g. smartlankatradedb_low)
# and provide absolute path to unzipped wallet directory:
DB_WALLET_PATH=C:\oracle\SmartLankaTradeDB\Wallet_SmartLankaTradeDB
DB_WALLET_PASSWORD=your_wallet_password_if_encrypted

# Oracle Connection Pool Tuning (Optional)
DB_POOL_MAX=15
DB_POOL_MIN=2
DB_POOL_INCREMENT=1
DB_POOL_TIMEOUT=60
DB_QUEUE_TIMEOUT=60000

# ------------------------------------------------------------
# 3. Email Delivery & OTP Security (Brevo Transactional API / HMAC-SHA256)
# ------------------------------------------------------------
# Brevo (formerly Sendinblue) Transactional Email API Key (e.g. xkeysib-...)
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
# Verified Brevo Sender Email address
BREVO_SENDER=no-reply@yourdomain.com
# Secret key used for HMAC-SHA256 cryptographic OTP hashing
OTP_SECRET=your_super_secret_otp_hmac_key_here_change_in_production

# ------------------------------------------------------------
# 4. Binance Market Data & API Configuration
# ------------------------------------------------------------
# Public market-data endpoints work without API keys, but keys are recommended for higher rate limits.
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
BINANCE_BASE_URL=https://api.binance.com

# ------------------------------------------------------------
# 5. Google OAuth Authentication
# ------------------------------------------------------------
# Web OAuth Client ID (used by the backend to verify id_token)
GOOGLE_CLIENT_ID=your_google_oauth_web_client_id_here.apps.googleusercontent.com
# Android OAuth Client ID (created in Google Cloud Console, type: Android)
# Package name: com.michael_clerans.SmartLankaTrade
# If not set, falls back to GOOGLE_CLIENT_ID
GOOGLE_ANDROID_CLIENT_ID=your_google_oauth_android_client_id_here.apps.googleusercontent.com

